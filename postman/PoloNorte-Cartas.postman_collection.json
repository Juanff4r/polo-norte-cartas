{
  "info": {
    "name": "Polo Norte · Cartas a Santa (Escenario A)",
    "description": "Ejecutar en orden con el Runner. Requiere la API en :8000 y el mock SOAP en :8081 (nombres: Grinch=Fault, Travies*=TRAVIESO). Si usas el mock del docente, ajusta los nombres de los casos 12-15.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "tokenJefe",
      "value": "token-elfo-jefe-demo"
    },
    {
      "key": "tokenElfo",
      "value": "token-elfo-demo"
    },
    {
      "key": "cartaBuenaId",
      "value": ""
    },
    {
      "key": "cartaTraviesaId",
      "value": ""
    },
    {
      "key": "cartaGrinchId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Crear carta (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/cartas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "cartas"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"remitente\": \"Valentina Pérez\",\n  \"edad\": 9,\n  \"ciudad\": \"Guayaquil\",\n  \"regalos\": [\n    \"Bicicleta\",\n    \"Libro de cuentos\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('estado = RECIBIDA', () => pm.expect(pm.response.json().estado).to.eql('RECIBIDA'));",
              "pm.test('comportamiento = PENDIENTE_VERIFICACION', () => pm.expect(pm.response.json().comportamiento).to.eql('PENDIENTE_VERIFICACION'));",
              "pm.collectionVariables.set('cartaBuenaId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Listar con filtros (200) — público, sin edad",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/cartas?estado=RECIBIDA&ciudad=Guayaquil",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "cartas"
          ],
          "query": [
            {
              "key": "estado",
              "value": "RECIBIDA"
            },
            {
              "key": "ciudad",
              "value": "Guayaquil"
            }
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Es lista y no expone edad', () => { const l = pm.response.json(); pm.expect(l).to.be.an('array'); l.forEach(c => pm.expect(c).to.not.have.property('edad')); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Detalle (200)",
